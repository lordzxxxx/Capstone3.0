{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "find . -type f -name '*.js' -not -path './node_modules/*' -print0 | xargs -0 -n1 node --check",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "set-cho-role": "node set_cho_role.js",
    "set-cho-role-key": "node set_cho_role.js --key ./service-account.json"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "nodemailer": "^10.1.1"
  },
  "overrides": {
    "@fastify/busboy": "3.2.3"
  }
}
