rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Optimized rules with better performance

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function authRole() {
      return isSignedIn() && ('role' in request.auth.token)
        ? request.auth.token.role
        : '';
    }

    function tokenRole() {
      return authRole();
    }

    function roleEqualsAny(role, allowedRoles) {
      return role != null && allowedRoles.hasAny([role]);
    }

    function tokenRolesHasAny(allowedRoles) {
      return isSignedIn() &&
        ('roles' in request.auth.token) &&
        request.auth.token.roles is list &&
        request.auth.token.roles.hasAny(allowedRoles);
    }

    function authBarangay() {
      return isSignedIn() && ('barangay' in request.auth.token)
        ? request.auth.token.barangay
        : (
          isSignedIn() && ('barangayName' in request.auth.token)
            ? request.auth.token.barangayName
            : ''
        );
    }

    function authBarangayCode() {
      return isSignedIn() && ('barangayCode' in request.auth.token)
        ? request.auth.token.barangayCode
        : (
          isSignedIn() && ('barangay_code' in request.auth.token)
            ? request.auth.token.barangay_code
            : ''
        );
    }

    function hasApprovedActiveProfile() {
      let profile = currentUser();
      return profile != null &&
        (
          (
            ('approvalStatus' in profile) &&
            profile.approvalStatus in ['approved', 'Approved']
          ) ||
          (('isApproved' in profile) && profile.isApproved == true)
        ) &&
        (
          (
            ('accountStatus' in profile) &&
            profile.accountStatus in ['active', 'Active', 'approved', 'Approved']
          ) ||
          (
            ('status' in profile) &&
            profile.status in ['active', 'Active', 'approved', 'Approved']
          )
        );
    }

    function userRole() {
      return hasApprovedActiveProfile() &&
        ('role' in currentUser()) &&
        currentUser().role != ''
          ? currentUser().role
          : '';
    }

    function userBarangay() {
      return currentUser() != null && ('barangay' in currentUser()) && currentUser().barangay != ''
        ? currentUser().barangay
        : authBarangay();
    }

    function userBarangayCode() {
      return currentUser() != null && ('barangayCode' in currentUser()) && currentUser().barangayCode != ''
        ? currentUser().barangayCode
        : authBarangayCode();
    }

    function authEmail() {
      return isSignedIn() && ('email' in request.auth.token)
        ? request.auth.token.email
        : '';
    }

    function canReadOwnUserDoc(userId, data) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        (data != null && ('uid' in data) && data.uid == request.auth.uid) ||
        (authEmail() != '' && (
          (data != null && ('email' in data) && data.email == authEmail()) ||
          (data != null && ('emailLower' in data) && data.emailLower == authEmail())
        ))
      );
    }

    function isAllowedSignupRole(role) {
      return roleEqualsAny(role, ['BHW']);
    }

    function hasValidRegistrationIntent(userId, data) {
      let intent = get(
        /databases/$(database)/documents/registration_intents/$(userId)
      );
      return isSignedIn() &&
        exists(/databases/$(database)/documents/registration_intents/$(userId)) &&
        ('registrationNonce' in data) &&
        data.registrationNonce is string &&
        data.registrationNonce.matches('[A-Fa-f0-9]{64}') &&
        ('username' in data) &&
        ('usernameLower' in data) &&
        data.username is string &&
        data.usernameLower is string &&
        intent.data.uid == userId &&
        intent.data.registrationNonce == data.registrationNonce &&
        intent.data.emailLower == data.email.lower() &&
        intent.data.usernameLower == data.usernameLower &&
        intent.data.role == data.role &&
        intent.data.expiresAt > request.time &&
        (data.role == 'BHW' &&
          ('barangayCode' in data) &&
          intent.data.barangayCode.lower() == data.barangayCode.lower());
    }

    function canCreateOwnUserProfile(userId, data) {
      return isSignedIn() &&
        request.auth.uid == userId &&
        data.uid == request.auth.uid &&
        isAllowedSignupRole(data.role) &&
        (
          data.role == 'BHW' &&
          data.approvalStatus == 'pending' &&
          data.accountStatus == 'pending_approval' &&
          data.isApproved == false
        ) &&
        data.email == authEmail() &&
        hasValidRegistrationIntent(userId, data);
    }

    function preservesProtectedUserFields(existingData, newData) {
      return !newData.diff(existingData).affectedKeys().hasAny([
        'uid',
        'email',
        'emailLower',
        'role',
        'roles',
        'approvalStatus',
        'accountStatus',
        'isApproved',
        'status',
        'accessScope',
        'organizationLevel',
        'dataVisibilityStartAt',
        'barangay',
        'barangayCode',
        'barangayDistrict',
        'barangayVerified',
        'barangayPath',
        'barangayUserPath',
        'createdAt',
        'accessRoleKey',
        'permissions'
      ]);
    }

    function isChoRole() {
      let choRoles = [
        'CHO',
        'cho',
        'CHO_ADMIN',
        'cho_admin',
        'CHO_SUPER_ADMIN',
        'cho_super_admin'
      ];
      return isSignedIn() && hasApprovedActiveProfile() &&
        ('role' in currentUser()) && roleEqualsAny(currentUser().role, choRoles);
    }

    function isChoAdmin() {
      let adminRoles = [
        'CHO_ADMIN', 'cho_admin',
        'CHO_SUPER_ADMIN', 'cho_super_admin'
      ];
      return isSignedIn() && hasApprovedActiveProfile() &&
        ('role' in currentUser()) && roleEqualsAny(currentUser().role, adminRoles);
    }

    // Built-in permissions keep legacy profiles working until their next
    // managed-account update writes the explicit permission list. Custom
    // roles always carry a list, so removing a permission is enforced here,
    // not only by the Flutter sidebar.
    function builtInPermissionForRole(role, permission) {
      return (role in ['BHW', 'bhw'] && permission in [
        'dashboard.view', 'patients.view', 'patients.create', 'patients.edit',
        'checkups.view', 'checkups.create', 'checkups.edit',
        'prenatal.view', 'prenatal.create', 'prenatal.edit',
        'immunization.view', 'immunization.create', 'immunization.edit',
        'immunization.vaccine_master.view', 'surveillance.view',
        'surveillance.create', 'surveillance.edit', 'referrals.view',
        'referrals.create', 'referrals.status.update', 'reports.view',
        'reports.export', 'notifications.view', 'profile.view'
      ]) ||
      (role in ['CHO', 'cho'] && permission in [
        'dashboard.view', 'patients.view', 'patients.create', 'patients.edit',
        'checkups.view', 'checkups.create', 'checkups.edit',
        'prenatal.view', 'prenatal.create', 'prenatal.edit',
        'immunization.view', 'immunization.create', 'immunization.edit',
        'immunization.vaccine_master.view', 'surveillance.view',
        'surveillance.create', 'surveillance.edit', 'referrals.view',
        'referrals.status.update', 'reports.view', 'reports.export',
        'data_quality.view', 'audit.view', 'notifications.view', 'profile.view'
      ]) ||
      (role in ['DOCTOR', 'doctor'] && permission in [
        'dashboard.view', 'patients.view', 'checkups.view', 'prenatal.view',
        'immunization.view', 'surveillance.view', 'referrals.view',
        'referrals.assigned.view', 'notifications.view', 'profile.view'
      ]);
    }

    function hasPermission(permission) {
      let profile = currentUser();
      return isSignedIn() && profile != null && profileHasPermission(profile, permission);
    }

    function profileHasPermission(profile, permission) {
      return profile != null &&
        (
          profile.role in [
            'CHO_ADMIN', 'cho_admin', 'CHO_SUPER_ADMIN', 'cho_super_admin',
          ] ||
          (('permissions' in profile) && profile.permissions is list &&
            profile.permissions.hasAny([permission])) ||
          (!('permissions' in profile) &&
            builtInPermissionForRole(profile.role, permission))
        );
    }

    function activeProfileHasRole(profile, allowedRoles) {
      return isSignedIn() && profile != null &&
        ('role' in profile) && allowedRoles.hasAny([profile.role]) &&
        (
          (('approvalStatus' in profile) &&
            profile.approvalStatus in ['approved', 'Approved']) ||
          (('isApproved' in profile) && profile.isApproved == true)
        ) &&
        (
          (('accountStatus' in profile) &&
            profile.accountStatus in ['active', 'Active', 'approved', 'Approved']) ||
          (('status' in profile) &&
            profile.status in ['active', 'Active', 'approved', 'Approved'])
        );
    }

    function profileSameBarangay(profile, data) {
      return profile != null && data != null &&
        (
          (('barangayCode' in data) && ('barangayCode' in profile) &&
            data.barangayCode.lower() == profile.barangayCode.lower()) ||
          (('barangay' in data) && ('barangay' in profile) &&
            data.barangay == profile.barangay)
        );
    }

    function canReadScopedRecordWithPermission(data, permission) {
      let profile = currentUser();
      return (activeProfileHasRole(profile, [
        'CHO', 'cho', 'CHO_ADMIN', 'cho_admin', 'CHO_SUPER_ADMIN',
        'cho_super_admin'
      ]) && profileHasPermission(profile, permission)) ||
        (activeProfileHasRole(profile, ['BHW', 'bhw']) &&
          profileHasPermission(profile, permission) &&
          profileSameBarangay(profile, data));
    }

    function canWriteScopedRecordWithPermission(data, permission) {
      return canReadScopedRecordWithPermission(data, permission);
    }

    function canReadBarangayScopedRecordWithPermission(barangayCode, data, permission) {
      let profile = currentUser();
      return (activeProfileHasRole(profile, [
        'CHO', 'cho', 'CHO_ADMIN', 'cho_admin', 'CHO_SUPER_ADMIN',
        'cho_super_admin'
      ]) && profileHasPermission(profile, permission)) ||
        (activeProfileHasRole(profile, ['BHW', 'bhw']) &&
          profileHasPermission(profile, permission) &&
          (('barangayCode' in profile) && profile.barangayCode.lower() == barangayCode.lower() ||
            profileSameBarangay(profile, data)));
    }

    function isBhwRole() {
      let bhwRoles = ['BHW', 'bhw'];
      return isSignedIn() && hasApprovedActiveProfile() &&
        roleEqualsAny(userRole(), bhwRoles);
    }

    function isDoctorRole() {
      let doctorRoles = ['DOCTOR', 'doctor'];
      return isSignedIn() && hasApprovedActiveProfile() &&
        roleEqualsAny(userRole(), doctorRoles);
    }

    function sameBarangay(data) {
      return isSignedIn() && userRole() != '' && data != null && (
        (('barangayCode' in data) &&
          data.barangayCode.lower() == userBarangayCode().lower()) ||
        (('barangay' in data) && data.barangay == userBarangay())
      );
    }

    function canReadScopedRecord(data) {
      return isChoRole() || sameBarangay(data);
    }

    function canWriteScopedRecord(data) {
      return isChoRole() || (isBhwRole() && sameBarangay(data));
    }

    function sameBarangayPath(barangayCode) {
      // Web collection paths use an uppercase normalized code while user
      // profiles retain the canonical lowercase barangay code. Compare the
      // normalized values so both existing path formats remain accessible.
      return isSignedIn() &&
        userBarangayCode().lower() == barangayCode.lower();
    }

    function canReadBarangayScopedRecord(barangayCode, data) {
      return isChoRole() ||
        (isBhwRole() && sameBarangayPath(barangayCode)) ||
        sameBarangay(data);
    }

    function canWriteBarangayScopedRecord(barangayCode, data) {
      return isChoRole() ||
        (
          isBhwRole() &&
          sameBarangay(data) &&
          (
            sameBarangayPath(barangayCode) ||
            (('barangay' in data) && data.barangay == userBarangay())
          )
        );
    }

    function canUpdateImmunizationRecord(existingData, newData) {
      return canReadScopedRecordWithPermission(existingData, 'immunization.edit') &&
        canReadScopedRecordWithPermission(newData, 'immunization.edit');
    }

    // Immunization records are intentionally validated at the write boundary.
    // Reads remain compatible with historical documents that predate these
    // checks; only new or edited values must satisfy the safe type/length
    // constraints below.
    function safeOptionalText(data, field, maxLength) {
      return !(field in data) || (
        data[field] is string &&
        data[field].size() <= maxLength
      );
    }

    function safeRequiredText(data, field, maxLength) {
      return field in data &&
        data[field] is string &&
        data[field].size() > 0 &&
        data[field].size() <= maxLength &&
        data[field].matches('.*[^\\s].*');
    }

    function validImmunizationRecord(data, requireCoreFields) {
      return (
        (!requireCoreFields || safeRequiredText(data, 'patientName', 200)) &&
        (!requireCoreFields || safeRequiredText(data, 'vaccine', 120)) &&
        (!requireCoreFields || safeRequiredText(data, 'administrationDate', 40)) &&
        (!requireCoreFields || safeRequiredText(data, 'status', 40)) &&
        safeOptionalText(data, 'patientName', 200) &&
        safeOptionalText(data, 'patientId', 120) &&
        safeOptionalText(data, 'linkedPatientId', 120) &&
        safeOptionalText(data, 'middleName', 120) &&
        safeOptionalText(data, 'age', 16) &&
        safeOptionalText(data, 'contactNumber', 32) &&
        safeOptionalText(data, 'doseNumber', 40) &&
        safeOptionalText(data, 'parentGuardianName', 200) &&
        safeOptionalText(data, 'adverseEvents', 2000)
      );
    }

    function validImmunizationUpdate(newData) {
      // Legacy records may not contain every modern field. Validate the
      // fields that are present while allowing those historical documents to
      // remain editable; newly-created documents receive the complete
      // core-field validation above.
      return (!('patientName' in newData) ||
          safeRequiredText(newData, 'patientName', 200)) &&
        (!('vaccine' in newData) || safeRequiredText(newData, 'vaccine', 120)) &&
        (!('administrationDate' in newData) ||
          safeRequiredText(newData, 'administrationDate', 40)) &&
        (!('status' in newData) || safeRequiredText(newData, 'status', 40));
    }

    // Doctor notes are an append-only clinical log tied to a specific
    // check-up/consultation. Any CHO or DOCTOR account may read notes
    // (continuity of care requires a later doctor to see an earlier
    // doctor's notes, regardless of which referral they were assigned to);
    // BHW accounts may read notes for patients within their own barangay.
    function canReadDoctorNote(data) {
      return isChoRole() ||
        isDoctorRole() ||
        (isBhwRole() && sameBarangay(data));
    }

    function canCreateDoctorNote(data) {
      return (isChoRole() || isDoctorRole()) &&
        data.authorUid == request.auth.uid &&
        // Require the actual server-resolved write time, not a
        // client-supplied literal timestamp, so a note's recorded time
        // can't be backdated/postdated by a caller who bypasses the app
        // UI (e.g. driving the SDK directly) and skips
        // FieldValue.serverTimestamp().
        data.createdAt == request.time;
    }

    function canReadReferral(data) {
      return (isChoRole() && hasPermission('referrals.view')) ||
        (isDoctorRole() && hasPermission('referrals.assigned.view') &&
          data.assignedDoctorUid == request.auth.uid) ||
        (isBhwRole() && hasPermission('referrals.view') &&
          data.createdByUid == request.auth.uid);
    }

    function canCreateReferral(data) {
      return (isChoRole() && hasPermission('referrals.create')) ||
        (isBhwRole() && hasPermission('referrals.create') &&
          data.createdByUid == request.auth.uid && sameBarangay(data) &&
          !('assignedDoctorUid' in data) &&
          !('assignedDoctorName' in data) &&
          !('assignmentEventId' in data) &&
          !('assignmentNotificationSentFor' in data));
    }

    function isAllowedDoctorReferralTransition(currentStatus, nextStatus) {
      return
        (currentStatus in [
            'approved', 'assigned', 'hospital_assigned', 'doctor_assigned'
          ] &&
          nextStatus in ['doctor_assigned', 'waiting_consultation', 'consulted']) ||
        (currentStatus == 'waiting_consultation' &&
          nextStatus in ['waiting_consultation', 'consulted']) ||
        (currentStatus in ['in_treatment', 'consulted'] &&
          nextStatus in ['consulted', 'completed']) ||
        (currentStatus == 'completed' && nextStatus == 'completed');
    }

    function canUpdateReferral(existingData, newData) {
      let role = userRole();
      let changed = newData.diff(existingData).affectedKeys();
      let bhwOwnsRecord = existingData.createdByUid == request.auth.uid &&
        newData.createdByUid == request.auth.uid &&
        newData.barangayCode == existingData.barangayCode &&
        newData.barangay == existingData.barangay;
      let correctsReturned = existingData.status in [
          'returned',
          'returned_for_correction',
          'return_for_correction'
        ] &&
        (newData.status == 'pending_review' ||
          newData.status == 'submitted') &&
        newData.submissionStatus == 'submitted' &&
        changed.hasOnly([
          'patientId', 'patientRecordId', 'linkedPatientId', 'patientName',
          'patientInformation', 'latestCheckup', 'latestVitalSigns',
          'prenatalInformation', 'morbidityInformation', 'homeCare',
          'referralReason', 'priority', 'observations', 'bhwNotes',
          'supportingNotes', 'destinationFacility', 'attachments', 'status',
          'submissionStatus', 'submittedAt', 'updatedAt', 'statusHistory'
        ]);
      let recordsFollowUp = existingData.status in ['consulted', 'completed'] &&
        newData.status == existingData.status &&
        changed.hasOnly([
          'followUps', 'latestFollowUpNotes', 'homeVisitCompleted',
          'homeVisitCompletedAt', 'updatedAt'
        ]);
      // Mirrors the app's own doctor-consultation update payload exactly
      // (lib/app/features/referrals/referrals.dart: doctorDiagnosis,
      // doctorTreatment, doctorMedication, doctorNotes, status,
      // doctorUpdatedAt, updatedAt). Without this allowlist, the earlier
      // rule let any doctor already assigned to a referral rewrite *any*
      // field on it (e.g. assignedHospital, priority, patientName) as long
      // as assignedDoctorUid stayed the same -- verified with
      // tests/firestore.rules.test.cjs's "doctor scope" case before this
      // fix, which found the over-broad update succeeding.
      let recordsConsultation = changed.hasOnly([
        'doctorDiagnosis', 'doctorTreatment', 'doctorMedication',
        'doctorNotes', 'status', 'doctorUpdatedAt', 'updatedAt',
        'completionStatus', 'completedAt', 'completedByDoctorUid',
        'completedByDoctorName'
      ]) && isAllowedDoctorReferralTransition(
        existingData.status,
        newData.status
      ) && (
        newData.status != 'completed' ||
        (
          ('completionStatus' in newData) &&
          newData.completionStatus == 'completed' &&
          ('completedByDoctorUid' in newData) &&
          newData.completedByDoctorUid == request.auth.uid
        )
      );
      let choReview = changed.hasOnly([
        'status', 'submissionStatus', 'priority', 'choReviewNotes',
        'reviewedByUid', 'reviewedByEmail', 'reviewedAt', 'updatedAt',
        'assignedHospital', 'receivingHospital',
        'expectedConsultationDate', 'approvedAt', 'statusHistory'
      ]);
      return (role in [
          'CHO_ADMIN', 'cho_admin', 'CHO_SUPER_ADMIN', 'cho_super_admin',
        ] && hasPermission('referrals.reassign')) ||
        (role in ['CHO', 'cho'] && hasPermission('referrals.status.update') && choReview) ||
        (role in ['DOCTOR', 'doctor'] &&
          hasPermission('referrals.assigned.view') &&
          existingData.assignedDoctorUid == request.auth.uid &&
          newData.assignedDoctorUid == request.auth.uid &&
          recordsConsultation) ||
        (role in ['BHW', 'bhw'] &&
          hasPermission('referrals.status.update') &&
          bhwOwnsRecord &&
          (correctsReturned || recordsFollowUp));
    }

    function isSuperAdmin() {
      let superRoles = [
        'CHO_ADMIN',
        'cho_admin',
        'CHO_SUPER_ADMIN',
        'cho_super_admin'
      ];
      return isSignedIn() && hasApprovedActiveProfile() &&
        ('role' in currentUser()) && roleEqualsAny(currentUser().role, superRoles);
    }
    
    // User profile/role docs - Allow authenticated users to create and update their own profile
    // This is used during signup and user profile management
    match /users/{userId} {
      allow get: if canReadOwnUserDoc(userId, resource.data) ||
        (isChoRole() && hasPermission('cho.users.view'));
      allow list: if isChoRole() && hasPermission('cho.users.view');
      allow create: if canCreateOwnUserProfile(userId, request.resource.data) || isChoAdmin();
      allow update: if (
        isSignedIn() &&
        request.auth.uid == userId &&
        preservesProtectedUserFields(resource.data, request.resource.data)
      ) || isChoAdmin();
      allow delete: if isChoAdmin();
    }

    // Dedicated CHO review queue. A BHW creates exactly one pending request
    // using their own UID during the same transaction as account registration.
    match /bhw_registration_requests/{userId} {
      allow get: if canReadOwnUserDoc(userId, resource.data) ||
        (isChoAdmin() && hasPermission('bhw.requests.view'));
      allow list: if isChoAdmin() && hasPermission('bhw.requests.view');
      allow create: if canCreateOwnUserProfile(userId, request.resource.data) &&
        request.resource.data.requestId == userId &&
        request.resource.data.applicantUid == request.auth.uid &&
        request.resource.data.requestType == 'BHW_ACCOUNT_REGISTRATION' &&
        request.resource.data.submissionStatus == 'submitted';
      allow update: if isChoAdmin() &&
        (hasPermission('bhw.approve') || hasPermission('bhw.reject'));
      allow delete: if isChoAdmin() && hasPermission('bhw.reject');
    }

    // Role documents are read-only to clients. Role CRUD is performed by the
    // callable functions, which validate the caller, protect core roles, and
    // prevent deleting roles that are still assigned to users.
    match /roles/{roleId} {
      allow read: if isChoAdmin() && hasPermission('rbac.view');
      allow write: if false;
    }

    // CHO-managed doctor registry for referral assignment workflows
    match /doctor_registry/{doctorId} {
      allow read: if isChoRole() && hasPermission('doctors.view');
      allow create, update, delete: if isChoAdmin() && hasPermission('doctors.manage');
    }

    match /barangays/{barangayCode}/users/{userId} {
      allow read: if canReadOwnUserDoc(userId, resource.data) || isChoRole();
      allow create: if isSignedIn() &&
        (canCreateOwnUserProfile(userId, request.resource.data) || isChoAdmin()) &&
        request.resource.data.barangayCode == barangayCode;
      allow update: if isSignedIn() &&
        (
          (
            request.auth.uid == userId &&
            preservesProtectedUserFields(resource.data, request.resource.data)
          ) || isChoAdmin()
        ) &&
        resource.data.barangayCode == barangayCode &&
        request.resource.data.barangayCode == barangayCode;
      allow delete: if isChoAdmin();
    }

    match /barangays/{barangayCode} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource.data.barangayCode == barangayCode &&
        (
          isChoRole() ||
          isSuperAdmin() ||
          (isBhwRole() && sameBarangayPath(barangayCode))
        );
      allow delete: if isSuperAdmin();
    }

    match /barangays/{barangayCode}/workspace_modules/{moduleId} {
      allow read: if isSignedIn() &&
        (
          isChoRole() ||
          isSuperAdmin() ||
          sameBarangayPath(barangayCode)
        );
      allow create, update: if isSignedIn() &&
        request.resource.data.barangayCode == barangayCode &&
        (
          isChoRole() ||
          isSuperAdmin() ||
          (isBhwRole() && sameBarangayPath(barangayCode))
        );
      allow delete: if isSuperAdmin();
    }

    match /registration_username_locks/{usernameKey} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.usernameLower == usernameKey;
      allow update: if isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        resource.data.usernameLower == usernameKey &&
        request.resource.data.usernameLower == usernameKey;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /registration_barangay_locks/{barangayCode} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.barangayCode == barangayCode;
      allow update: if isSignedIn() &&
        (
          resource.data.uid == request.auth.uid ||
          isSuperAdmin()
        ) &&
        request.resource.data.barangayCode == barangayCode &&
        (
          request.resource.data.uid == resource.data.uid ||
          isSuperAdmin()
        );
      allow delete: if isSignedIn() &&
        (
          resource.data.uid == request.auth.uid ||
          isSuperAdmin()
        );
    }

    match /barangay_registration_status/{barangayCode} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.barangayCode == barangayCode &&
        request.resource.data.isAvailable == false &&
        (
          request.resource.data.uid == request.auth.uid ||
          isSuperAdmin()
        );
      allow update: if isSignedIn() &&
        (
          resource.data.uid == request.auth.uid ||
          isSuperAdmin()
        ) &&
        request.resource.data.barangayCode == barangayCode &&
        request.resource.data.isAvailable == false &&
        (
          request.resource.data.uid == resource.data.uid ||
          isSuperAdmin()
        );
      allow delete: if isSignedIn() &&
        (
          resource.data.uid == request.auth.uid ||
          isSuperAdmin()
        );
    }

    match /invitations/{invitationId} {
      allow read, create, update, delete: if isChoAdmin();
    }

    match /barangay_branding/{barangayCode} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /referrals/{referralId} {
      allow read: if canReadReferral(resource.data);
      allow create: if canCreateReferral(request.resource.data);
      allow update: if canUpdateReferral(resource.data, request.resource.data);
      allow delete: if isChoRole();
    }

    match /barangays/{barangayCode}/referrals/{referralId} {
      allow read: if canReadReferral(resource.data);
      allow create: if canCreateReferral(request.resource.data) &&
        request.resource.data.barangayCode == barangayCode;
      allow update: if canUpdateReferral(resource.data, request.resource.data) &&
        resource.data.barangayCode == barangayCode &&
        request.resource.data.barangayCode == barangayCode;
      allow delete: if isChoRole();
    }

    // Ensure CHO can list/read all record collections via collectionGroup queries.
    // Keep these static collection-id matches so Firestore can safely evaluate
    // collectionGroup access across every possible parent path.
    match /{documentPath=**}/checkup_records/{recordId} {
      allow read: if isChoRole() && hasPermission('checkups.view');
    }
    match /{documentPath=**}/prenatal_records/{recordId} {
      allow read: if isChoRole() && hasPermission('prenatal.view');
    }
    match /{documentPath=**}/immunization_records/{recordId} {
      allow read: if isChoRole() && hasPermission('immunization.view');
    }
    match /{documentPath=**}/patient_records/{recordId} {
      allow read: if isChoRole() && hasPermission('patients.view');
    }
    match /{documentPath=**}/barangay_records/{recordId} {
      allow read: if isChoRole() && hasPermission('surveillance.view');
    }
    match /{documentPath=**}/morbidity_records/{recordId} {
      allow read: if isChoRole() && hasPermission('surveillance.view');
    }
    match /{documentPath=**}/mortality_records/{recordId} {
      allow read: if isChoRole() && hasPermission('surveillance.view');
    }
    match /{documentPath=**}/summary_records/{recordId} {
      allow read: if isChoRole() && hasPermission('reports.view');
    }
    
    // Health records - all by authenticated users
    match /checkup_records/{recordId} {
      allow read: if canReadScopedRecordWithPermission(resource.data, 'checkups.view');
      allow create: if canWriteScopedRecordWithPermission(request.resource.data, 'checkups.create');
      allow update: if canWriteScopedRecordWithPermission(resource.data, 'checkups.edit') &&
        canWriteScopedRecordWithPermission(request.resource.data, 'checkups.edit');
      allow delete: if canWriteScopedRecordWithPermission(resource.data, 'checkups.edit');
    }
    match /barangays/{barangayCode}/checkup_records/{recordId} {
      allow read: if canReadBarangayScopedRecordWithPermission(barangayCode, resource.data, 'checkups.view');
      allow create: if canWriteBarangayScopedRecord(barangayCode, request.resource.data) &&
        hasPermission('checkups.create') &&
        request.resource.data.barangayCode == barangayCode;
      allow update: if canWriteBarangayScopedRecord(barangayCode, resource.data) &&
        canWriteBarangayScopedRecord(barangayCode, request.resource.data) &&
        hasPermission('checkups.edit') &&
        resource.data.barangayCode == barangayCode &&
        request.resource.data.barangayCode == barangayCode;
      allow delete: if canWriteBarangayScopedRecord(barangayCode, resource.data) &&
        hasPermission('checkups.edit');
    }
    match /prenatal_records/{recordId} {
      allow read: if canReadScopedRecordWithPermission(resource.data, 'prenatal.view');
      allow create: if canWriteScopedRecordWithPermission(request.resource.data, 'prenatal.create');
      allow update: if canWriteScopedRecordWithPermission(resource.data, 'prenatal.edit') &&
        canWriteScopedRecordWithPermission(request.resource.data, 'prenatal.edit');
      allow delete: if canWriteScopedRecordWithPermission(resource.data, 'prenatal.edit');
    }
    match /barangays/{barangayCode}/prenatal_records/{recordId} {
      allow read: if canReadBarangayScopedRecordWithPermission(barangayCode, resource.data, 'prenatal.view');
      allow create: if canWriteBarangayScopedRecord(barangayCode, request.resource.data) &&
        hasPermission('prenatal.create') &&
        request.resource.data.barangayCode == barangayCode;
      allow update: if canWriteBarangayScopedRecord(barangayCode, resource.data) &&
        canWriteBarangayScopedRecord(barangayCode, request.resource.data) &&
        hasPermission('prenatal.edit') &&
        resource.data.barangayCode == barangayCode &&
        request.resource.data.barangayCode == barangayCode;
      allow delete: if canWriteBarangayScopedRecord(barangayCode, resource.data) &&
        hasPermission('prenatal.edit');
    }
    match /immunization_records/{recordId} {
      allow read: if canReadScopedRecordWithPermission(resource.data, 'immunization.view');
      allow create: if canWriteScopedRecordWithPermission(request.resource.data, 'immunization.create') &&
        validImmunizationRecord(request.resource.data, true);
      allow update: if canUpdateImmunizationRecord(resource.data, request.resource.data) &&
        hasPermission('immunization.edit') &&
        validImmunizationUpdate(request.resource.data);
      allow delete: if canWriteScopedRecordWithPermission(resource.data, 'immunization.edit');
    }
    match /barangays/{barangayCode}/immunization_records/{recordId} {
      allow read: if canReadBarangayScopedRecordWithPermission(barangayCode, resource.data, 'immunization.view');
      allow create: if canWriteBarangayScopedRecord(barangayCode, request.resource.data) &&
        hasPermission('immunization.create') &&
        request.resource.data.barangayCode == barangayCode &&
        validImmunizationRecord(request.resource.data, true);
      allow update: if canUpdateImmunizationRecord(resource.data, request.resource.data) &&
        resource.data.barangayCode == barangayCode &&
        request.resource.data.barangayCode == barangayCode &&
        validImmunizationUpdate(request.resource.data);
      allow delete: if canWriteBarangayScopedRecord(barangayCode, resource.data) &&
        hasPermission('immunization.edit');
    }
    match /patient_records/{recordId} {
      allow read: if canReadScopedRecordWithPermission(resource.data, 'patients.view');
      allow create: if canWriteScopedRecordWithPermission(request.resource.data, 'patients.create');
      allow update: if canWriteScopedRecordWithPermission(resource.data, 'patients.edit') &&
        canWriteScopedRecordWithPermission(request.resource.data, 'patients.edit');
      allow delete: if canWriteScopedRecordWithPermission(resource.data, 'patients.edit');
    }
    match /barangays/{barangayCode}/patient_records/{recordId} {
      allow read: if canReadBarangayScopedRecordWithPermission(barangayCode, resource.data, 'patients.view');
      allow create: if canWriteBarangayScopedRecord(barangayCode, request.resource.data) &&
        hasPermission('patients.create') &&
        request.resource.data.barangayCode == barangayCode;
      allow update: if canWriteBarangayScopedRecord(barangayCode, resource.data) &&
        canWriteBarangayScopedRecord(barangayCode, request.resource.data) &&
        hasPermission('patients.edit') &&
        resource.data.barangayCode == barangayCode &&
        request.resource.data.barangayCode == barangayCode;
      allow delete: if canWriteBarangayScopedRecord(barangayCode, resource.data) &&
        hasPermission('patients.edit');
    }
    match /barangay_records/{recordId} {
      allow read: if canReadScopedRecordWithPermission(resource.data, 'surveillance.view');
      allow create: if canWriteScopedRecordWithPermission(request.resource.data, 'surveillance.create');
      allow update: if canWriteScopedRecordWithPermission(resource.data, 'surveillance.edit') &&
        canWriteScopedRecordWithPermission(request.resource.data, 'surveillance.edit');
      allow delete: if canWriteScopedRecordWithPermission(resource.data, 'surveillance.edit');
    }
    match /morbidity_records/{recordId} {
      allow read: if canReadScopedRecordWithPermission(resource.data, 'surveillance.view');
      allow create: if canWriteScopedRecordWithPermission(request.resource.data, 'surveillance.create');
      allow update: if canWriteScopedRecordWithPermission(resource.data, 'surveillance.edit') &&
        canWriteScopedRecordWithPermission(request.resource.data, 'surveillance.edit');
      allow delete: if canWriteScopedRecordWithPermission(resource.data, 'surveillance.edit');
    }
    match /barangays/{barangayCode}/morbidity_records/{recordId} {
      allow read: if canReadBarangayScopedRecordWithPermission(barangayCode, resource.data, 'surveillance.view');
      allow create: if canWriteBarangayScopedRecord(barangayCode, request.resource.data) &&
        hasPermission('surveillance.create') &&
        request.resource.data.barangayCode == barangayCode;
      allow update: if canWriteBarangayScopedRecord(barangayCode, resource.data) &&
        canWriteBarangayScopedRecord(barangayCode, request.resource.data) &&
        hasPermission('surveillance.edit') &&
        resource.data.barangayCode == barangayCode &&
        request.resource.data.barangayCode == barangayCode;
      allow delete: if canWriteBarangayScopedRecord(barangayCode, resource.data) &&
        hasPermission('surveillance.edit');
    }
    match /mortality_records/{recordId} {
      allow read: if canReadScopedRecordWithPermission(resource.data, 'surveillance.view');
      allow create: if canWriteScopedRecordWithPermission(request.resource.data, 'surveillance.create');
      allow update: if canWriteScopedRecordWithPermission(resource.data, 'surveillance.edit') &&
        canWriteScopedRecordWithPermission(request.resource.data, 'surveillance.edit');
      allow delete: if canWriteScopedRecordWithPermission(resource.data, 'surveillance.edit');
    }
    match /barangays/{barangayCode}/mortality_records/{recordId} {
      allow read: if canReadBarangayScopedRecordWithPermission(barangayCode, resource.data, 'surveillance.view');
      allow create: if canWriteBarangayScopedRecord(barangayCode, request.resource.data) &&
        hasPermission('surveillance.create') &&
        request.resource.data.barangayCode == barangayCode;
      allow update: if canWriteBarangayScopedRecord(barangayCode, resource.data) &&
        canWriteBarangayScopedRecord(barangayCode, request.resource.data) &&
        hasPermission('surveillance.edit') &&
        resource.data.barangayCode == barangayCode &&
        request.resource.data.barangayCode == barangayCode;
      allow delete: if canWriteBarangayScopedRecord(barangayCode, resource.data) &&
        hasPermission('surveillance.edit');
    }
    match /summary_records/{recordId} {
      allow read: if canReadScopedRecordWithPermission(resource.data, 'reports.view');
      allow create: if canWriteScopedRecordWithPermission(request.resource.data, 'reports.view');
      allow update: if canWriteScopedRecordWithPermission(resource.data, 'reports.view') &&
        canWriteScopedRecordWithPermission(request.resource.data, 'reports.view');
      allow delete: if canWriteScopedRecordWithPermission(resource.data, 'reports.view');
    }
    match /barangays/{barangayCode}/summary_records/{recordId} {
      allow read: if canReadBarangayScopedRecord(barangayCode, resource.data);
      allow create: if canWriteBarangayScopedRecord(barangayCode, request.resource.data) &&
        request.resource.data.barangayCode == barangayCode;
      allow update: if canWriteBarangayScopedRecord(barangayCode, resource.data) &&
        canWriteBarangayScopedRecord(barangayCode, request.resource.data) &&
        resource.data.barangayCode == barangayCode &&
        request.resource.data.barangayCode == barangayCode;
      allow delete: if canWriteBarangayScopedRecord(barangayCode, resource.data);
    }

    // Clinically reviewed disease knowledge. Signed-in app users may read only
    // active documents. Only authorized administrators may manage seed content.
    // Firebase Admin seed scripts bypass these client rules by design.
    match /diseases/{diseaseKey} {
      allow read: if isSuperAdmin() ||
        (isSignedIn() && resource.data.isActive == true);
      allow create, update, delete: if isSuperAdmin();
    }

    // Password reset collection. Written and read exclusively by the
    // sendPasswordResetEmail / verifyResetCode / completePasswordReset
    // Cloud Functions via the Admin SDK, which bypasses these rules — the
    // Flutter client never touches this collection through the Firestore
    // SDK (it only calls those HTTP endpoints). A prior "allow create: if
    // request.size < 2048" rule let ANY unauthenticated client write a
    // document here directly; since Firestore treats a set() on a
    // not-yet-existing document as a create, an attacker could forge
    // {verified: true, sessionToken: <their own value>} for any victim
    // email with no code, then call completePasswordReset with that
    // self-chosen token to take over the account. Deny all client access.
    match /password_resets/{document=**} {
      allow read, write: if false;
    }

    // Server-only rate-limit counters for the password-reset Cloud
    // Functions (send_password_reset.js). Written exclusively via the
    // Admin SDK; never exposed to the client.
    match /password_reset_rate_limits/{document=**} {
      allow read, write: if false;
    }

    // Doctor notes: append-only continuity-of-care log tied to a check-up.
    // Notes are never edited or deleted once written.
    match /doctor_notes/{noteId} {
      allow read: if canReadDoctorNote(resource.data);
      allow create: if canCreateDoctorNote(request.resource.data);
      allow update, delete: if false;
    }

    // Referral-review notifications. CHO creates them; the named recipient
    // (and CHO) may read them.
    match /notifications/{notificationId} {
      allow read: if isChoRole() ||
        (isSignedIn() && ('recipientUid' in resource.data) &&
          resource.data.recipientUid == request.auth.uid);
      allow create: if isChoRole();
      allow update, delete: if false;
    }

    // Reference list of partner hospitals/facilities used when assigning
    // referrals. Read-only reference data for signed-in users; managed by CHO.
    match /hospitals/{hospitalId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isChoRole();
    }

    // CHO-published announcements/broadcasts, visible to all signed-in staff.
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isChoRole();
    }

    // System audit trail. Read-only for CHO in the client; entries are
    // written by trusted backend processes (Cloud Functions using the
    // Admin SDK, which bypass these rules), never by client writes.
    match /audit_logs/{logId} {
      allow read: if isChoRole();
      allow write: if false;
    }
  }
}
