# Copy to .env and fill in local values. Never commit the real .env or key JSON.
# Absolute path to the server-only Firebase service-account JSON.
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/firebase-service-account.json
FIRESTORE_DATABASE_ID=capstone-c98f9
FIRESTORE_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO
APP_ENV=production

# Flutter web release build inputs. These are passed with --dart-define and
# are not read by the Python backend process.
AI_API_BASE_URL=https://api.example.com
FIREBASE_APP_CHECK_WEB_KEY=your-recaptcha-v3-site-key

# Exact hostnames accepted in the Host header by the deployed API. Do not use
# a wildcard in production; include the host used by your HTTPS API service.
API_ALLOWED_HOSTS=api.example.com

# Comma-separated exact browser origins allowed to call the AI API and
# password-reset HTTP functions. Do not use a wildcard in production.
WEB_ALLOWED_ORIGINS=https://your-project.vercel.app
AI_ALLOW_LOCAL_CORS=false

# Secure defaults are true even when these variables are omitted.
AI_REQUIRE_FIREBASE_AUTH=true
AI_REQUIRE_APP_CHECK=true
AI_CHECK_REVOKED_TOKENS=true
AI_RATE_LIMIT_REQUESTS=30
AI_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
AI_OCR_RATE_LIMIT_REQUESTS=10
AI_OCR_RATE_LIMIT_WINDOW_SECONDS=60
