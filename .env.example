# Copy to .env and fill in local values. Never commit the real .env or key JSON.
GOOGLE_APPLICATION_CREDENTIALS=C:\secure\firebase-service-account.json
FIRESTORE_DATABASE_ID=capstone-c98f9
FIRESTORE_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO

# Comma-separated exact browser origins allowed to call the AI API and
# password-reset HTTP functions. Do not use a wildcard in production.
WEB_ALLOWED_ORIGINS=https://your-project.vercel.app

# Secure defaults are true even when these variables are omitted.
AI_REQUIRE_FIREBASE_AUTH=true
AI_REQUIRE_APP_CHECK=true
AI_CHECK_REVOKED_TOKENS=true
AI_RATE_LIMIT_REQUESTS=30
AI_RATE_LIMIT_WINDOW_SECONDS=60
