# Copy to .env and fill in local values. Never commit the real .env or key JSON.
# Local development only: absolute path to the server-only Firebase
# service-account JSON. Cloud Run uses its attached service account/ADC and
# must leave this unset.
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/firebase-service-account.json
FIRESTORE_DATABASE_ID=capstone-c98f9
FIRESTORE_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO
APP_ENV=production
MODEL_VERSION=1.0.0
MODEL_EXPECTED_SHA256=4cc536ba3503283454f58c6f53d992350f1e6205317d3b3c50e7da3573cd370c
OCR_MODEL_NAME=microsoft/trocr-base-handwritten

# Flutter web release build inputs. These are passed with --dart-define and
# are not read by the Python backend process.
AI_API_BASE_URL=https://api.example.com
FIREBASE_APP_CHECK_WEB_KEY=your-recaptcha-v3-site-key

# Exact hostnames accepted in the Host header by the deployed API. Do not use
# a wildcard in production; include the host used by your HTTPS API service.
API_ALLOWED_HOSTS=api.example.com

# Comma-separated exact browser origins allowed to call the AI API and
# password-reset HTTP functions. Do not use a wildcard in production.
WEB_ALLOWED_ORIGINS=https://your-project.vercel.app
AI_ALLOW_LOCAL_CORS=false

# Secure defaults are true even when these variables are omitted.
AI_REQUIRE_FIREBASE_AUTH=true
AI_REQUIRE_APP_CHECK=true
AI_CHECK_REVOKED_TOKENS=true
AI_RATE_LIMIT_REQUESTS=30
AI_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
AI_OCR_RATE_LIMIT_REQUESTS=10
AI_OCR_RATE_LIMIT_WINDOW_SECONDS=60
# Use Firestore transactions for staging/production so limits apply across
# multiple backend instances. Local development may use RATE_LIMIT_BACKEND=memory.
RATE_LIMIT_BACKEND=firestore

# Grounded guidance retrieval and optional LLM explanation provider. The safe
# default is local deterministic explanation; set LLM_PROVIDER=http_json only
# after approving an HTTPS provider and its data-processing terms. The request
# sends recognized symptom/condition terms and reviewed guidance excerpts, not
# patient identifiers or saved clinical records.
RAG_TOP_K=8
RAG_MIN_SCORE=0.12
LLM_PROVIDER=disabled
LLM_ENDPOINT=https://provider.example.com/v1/chat/completions
LLM_API_KEY=replace-with-secret-manager-value
LLM_MODEL=configured-model
LLM_TIMEOUT_SECONDS=8
LLM_MAX_TOKENS=300
